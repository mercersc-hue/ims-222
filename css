/* Simone Mercer | Sport Sales & Business Development */
:root {
  --navy: #142b40;
  --navy-dark: #0b1d2d;
  --red: #e52b36;
  --pale-blue: #edf2f5;
  --white: #ffffff;
  --ink: #1b2c3c;
  --muted: #5d6b78;
  --line: #d6dfe5;
  --serif: Georgia, "Times New Roman", serif;
  --sans: Arial, Helvetica, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--ink);
  background: var(--white);
  font-family: var(--sans);
  line-height: 1.6;
}
a { color: inherit; }
.site-header {
  min-height: 76px;
  padding: 16px max(28px, calc((100vw - 1180px) / 2));
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30px;
  background: var(--navy-dark);
  color: var(--white);
}
.brand { color: white; font-size: 1.15rem; font-weight: 800; letter-spacing: .08em; line-height: 1.25; text-decoration: none; }
.brand span { display: block; margin-top: 4px; color: #c7d3dd; font-size: .65rem; font-weight: 500; letter-spacing: .1em; }
nav { display: flex; flex-wrap: wrap; gap: 28px; }
nav a { padding: 7px 0; border-bottom: 2px solid transparent; color: #f5f7f9; font-size: .9rem; text-decoration: none; }
nav a:hover, nav a:focus { border-color: var(--red); }

.hero {
  min-height: 420px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 70px max(28px, calc((100vw - 1180px) / 2));
  color: white;
  background:
    linear-gradient(90deg, rgba(8, 24, 39, .94) 0%, rgba(8, 24, 39, .76) 48%, rgba(8, 24, 39, .14) 100%),
    url("https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1800&q=85") center 50%/cover;
}
.hero-content { max-width: 680px; }
.eyebrow { margin: 0 0 10px; color: #66849b; font-size: .72rem; font-weight: 800; letter-spacing: .16em; }
.hero .eyebrow, .contact-section .eyebrow { color: #ff737b; }
h1, h2 { font-family: var(--sans); font-weight: 800; line-height: 1.08; letter-spacing: -.035em; }
h1 { margin: 0 0 18px; font-size: clamp(2.8rem, 6vw, 5rem); text-transform: uppercase; }
h1 span { color: #f1f4f6; }
.hero-content > p:not(.eyebrow) { max-width: 520px; color: #e4eaf0; font-size: 1.05rem; }
.button { display: inline-flex; align-items: center; gap: 20px; margin-top: 12px; padding: 13px 20px; background: var(--red); border: 2px solid var(--red); color: white; font-size: .85rem; font-weight: 800; text-decoration: none; transition: background .2s, transform .2s; }
.button:hover { transform: translateY(-3px); background: #bd1e29; border-color: #bd1e29; }
.hero-caption { position: absolute; right: max(28px, calc((100vw - 1180px) / 2)); bottom: 16px; margin: 0; color: white; font-size: .68rem; font-weight: 700; letter-spacing: .15em; }

.content-wrap { max-width: 1180px; margin: 0 auto; padding-left: 28px; padding-right: 28px; }
.feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; padding-top: 40px; padding-bottom: 48px; }
.feature { min-width: 0; padding-right: 22px; border-right: 1px solid var(--line); }
.feature:last-child { padding-right: 0; border-right: 0; }
.section-label { display: flex; align-items: center; gap: 13px; margin-bottom: 17px; }
.icon { width: 43px; height: 43px; flex: 0 0 43px; display: grid; place-items: center; border-radius: 50%; background: var(--navy); color: white; font-size: .78rem; font-weight: 800; }
.section-label .eyebrow { margin-bottom: 2px; font-size: .62rem; }
h2 { margin: 0; font-size: 1.55rem; text-transform: uppercase; }
.feature-image { width: 100%; height: 175px; margin-bottom: 17px; object-fit: cover; }
.portrait { object-position: center 40%; }
.feature > p { color: #354655; font-size: .9rem; }
.experience-list { margin: 0; padding-left: 18px; }
.experience-list li { padding: 0 0 12px 2px; font-size: .86rem; }
.experience-list strong, .experience-list span { display: block; }
.experience-list span { margin-top: 3px; color: var(--muted); font-size: .8rem; }
.text-link { display: inline-block; color: var(--red); font-size: .88rem; font-weight: 800; text-decoration: none; }
.text-link:hover { text-decoration: underline; text-underline-offset: 4px; }

.skills-section { background: var(--pale-blue); border-top: 1px solid #e2e8ec; border-bottom: 1px solid #dbe3e9; }
.skills-layout { display: grid; grid-template-columns: 2fr .9fr; gap: 42px; padding-top: 44px; padding-bottom: 44px; }
.skills-layout h2 { margin-bottom: 10px; }
.section-intro { margin: 0 0 22px; color: var(--muted); font-size: .9rem; }
.table-wrap { width: 100%; overflow-x: auto; }
table { width: 100%; border-collapse: collapse; background: white; font-size: .81rem; }
th { background: var(--navy); color: white; text-align: left; }
th, td { padding: 11px 13px; border: 1px solid #cbd6de; vertical-align: top; }
td:first-child { width: 30%; font-weight: 700; }
.quote-card { padding: 25px 28px; border-left: 1px solid #cbd6de; }
.quote-mark { color: var(--red); font-family: var(--serif); font-size: 4.3rem; font-weight: 800; line-height: .8; }
blockquote { margin: 8px 0 20px; font-family: var(--serif); font-size: 1.5rem; font-style: italic; line-height: 1.35; }
.quote-caption { margin: 0; color: var(--red); font-size: .7rem; font-weight: 800; letter-spacing: .15em; }

.contact-section { padding: 65px 28px 72px; background: var(--navy); color: white; text-align: center; }
.contact-section h2 { margin-bottom: 15px; font-size: clamp(2rem, 4vw, 3rem); }
.contact-section > p:not(.eyebrow) { max-width: 590px; margin: 0 auto 18px; color: #dce4eb; }
.button-light { background: transparent; border-color: white; }
.button-light:hover { background: white; color: var(--navy); border-color: white; }
.site-footer { display: grid; grid-template-columns: 1fr auto; gap: 12px 20px; align-items: center; max-width: 1180px; margin: 0 auto; padding: 22px 28px 16px; }
.site-footer p { margin: 0; font-size: .85rem; }
.site-footer p span { margin-left: 12px; padding-left: 12px; border-left: 1px solid var(--line); color: var(--muted); }
.site-footer > a { color: var(--navy); font-size: .82rem; font-weight: 700; text-decoration: none; }
.site-footer > a:hover { color: var(--red); }
.site-footer small { grid-column: 1 / -1; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; }

@media (max-width: 850px) {
  .site-header { align-items: flex-start; flex-direction: column; gap: 12px; }
  nav { gap: 20px; }
  .feature-grid { grid-template-columns: 1fr 1fr; }
  .feature:nth-child(2) { padding-right: 0; border-right: 0; }
  .feature:last-child { grid-column: 1 / -1; padding-top: 24px; border-top: 1px solid var(--line); }
  .feature:last-child .feature-image { height: 230px; }
  .skills-layout { grid-template-columns: 1fr; gap: 22px; }
  .quote-card { border-left: 0; border-top: 1px solid #cbd6de; padding: 24px 0 0; }
}
@media (max-width: 560px) {
  .site-header { padding: 16px 20px; }
  nav { gap: 12px 17px; }
  nav a { font-size: .82rem; }
  .hero { min-height: 440px; padding: 60px 20px 75px; background-position: 60% center; }
  h1 { font-size: clamp(2.5rem, 12vw, 3.8rem); }
  .hero-caption { left: 20px; right: auto; font-size: .6rem; }
  .content-wrap { padding-left: 20px; padding-right: 20px; }
  .feature-grid { grid-template-columns: 1fr; gap: 28px; padding-top: 30px; padding-bottom: 35px; }
  .feature, .feature:nth-child(2) { padding-right: 0; padding-bottom: 25px; border-right: 0; border-bottom: 1px solid var(--line); }
  .feature:last-child { grid-column: auto; padding-top: 0; padding-bottom: 0; border-top: 0; border-bottom: 0; }
  .feature-image, .feature:last-child .feature-image { height: 220px; }
  .skills-layout { padding-top: 35px; padding-bottom: 35px; }
  table { min-width: 470px; }
  .contact-section { padding: 52px 20px; }
  .site-footer { grid-template-columns: 1fr; padding: 20px; }
  .site-footer p span { display: block; margin: 4px 0 0; padding: 0; border: 0; }
  .site-footer small { grid-column: auto; }
}
